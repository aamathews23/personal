{
  "name": "@aamathews23/personal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "git clean -xdf node_modules target",
    "clean:workspace": "pnpm -r --if-present clean:workspace && pnpm clean",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "ci:publish": "pnpm publish --recursive --access public"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0"
  }
}
