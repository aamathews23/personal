{
  "name": "@aamathews23/battleship-web",
  "version": "1.0.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/battleship_web.d.ts",
  "exports": {
    ".": "./dist/battleship_web.js",
    "./battleship_web_bg.wasm": "./dist/battleship_web_bg.wasm"
  },
  "scripts": {
    "clean:workspace": "git clean -xdf dist node_modules",
    "build": "cargo build && wasm-pack build --out-dir=dist --target=web --release && rimraf dist/package.json",
    "lint": "cargo clippy",
    "lint:fix": "cargo clippy --fix",
    "typecheck": "echo 'No type checking in battleship-web package'",
    "test": "cargo test",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
