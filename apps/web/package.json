{
  "name": "@aamathews23/web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "clean:workspace": "git clean -xdf node_modules .wrangler build coverage .react-router",
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "pnpm build && vite preview",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types && react-router typegen",
    "cf-check": "tsc && react-router build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@aamathews23/battleship-web": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.33",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.13.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.17.1",
    "@eslint/js": "^9.39.2",
    "@react-router/dev": "7.13.0",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^6.4.1",
    "vite-plugin-top-level-await": "1.6.0",
    "vite-plugin-wasm": "3.5.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "4.60.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
