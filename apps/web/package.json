{
  "name": "@aamathews23/web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "clean:workspace": "git clean -xdf node_modules .wrangler build coverage .react-router",
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "pnpm build && vite preview",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types && react-router typegen",
    "cf-check": "tsc && react-router build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@aamathews23/battleship-web": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "5.1.39",
    "lucide-react": "1.14.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.14.2",
    "tailwind-merge": "3.5.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.35.0",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "7.14.2",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/eslint-plugin": "1.6.16",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vite-plugin-top-level-await": "1.6.0",
    "vite-plugin-wasm": "3.6.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.5",
    "wrangler": "4.87.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
