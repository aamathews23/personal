    "react-dom": "^18.2.0",
    "remix-utils": "^8.8.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250803.0",
    "@eslint/js": "^9.32.0",
    "@remix-run/dev": "^2.17.1",
    "@remix-run/testing": "^2.17.1",
    "@tailwindcss/vite": "^4.1.11",
